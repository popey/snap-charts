{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snap-charts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
