# Copy to .env and fill locally. .env is excluded from Git.
# Account ID from the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=

# Token with Workers Scripts edit and custom-domain permissions for popey.com.
CLOUDFLARE_API_TOKEN=

# R2 S3-compatible credential scoped to snap-charts-history (Object Read & Write).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Snap Store credentials are already in snap-charts.credentials; keep them there.
